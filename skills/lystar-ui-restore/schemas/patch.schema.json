{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lystar-ui-restore/patch.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "patchId", "scenarioId", "regionId", "problemType", "propertyFamily", "evidenceIds", "files", "baseFileSha256", "verification", "rollback", "status"],
  "properties": {
    "schemaVersion": {"type": "string", "minLength": 1},
    "patchId": {"type": "string", "minLength": 1},
    "scenarioId": {"type": "string", "minLength": 1},
    "regionId": {"type": "string", "minLength": 1},
    "visualOwner": {"type": "string"},
    "problemType": {"enum": ["structure", "geometry", "content", "typography", "surface", "rendering"]},
    "propertyFamily": {"enum": ["geometry", "structure", "content", "typography", "surface", "state"]},
    "evidenceIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "baseFileSha256": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
      ]
    },
    "before": {"type": "object"},
    "after": {"type": "object"},
    "expectedEffect": {"type": "string"},
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "beforeLocalDiffDensity": {"type": ["number", "null"]},
        "afterLocalDiffDensity": {"type": ["number", "null"]},
        "beforeGlobalDiffRatio": {"type": ["number", "null"]},
        "afterGlobalDiffRatio": {"type": ["number", "null"]},
        "status": {"enum": ["proposed", "accepted", "reverted", "blocked", "unresolved"]}
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "method"],
      "properties": {
        "available": {"type": "boolean"},
        "method": {"type": "string"}
      }
    },
    "validation": {"type": "object"},
    "gateChecks": {"type": "object"},
    "sourceMutation": {"const": "Pi.edit"},
    "status": {"enum": ["proposed", "accepted", "reverted", "blocked", "unresolved"]}
  }
}
