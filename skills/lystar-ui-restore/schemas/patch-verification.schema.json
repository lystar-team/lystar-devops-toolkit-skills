{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lystar-ui-restore/patch-verification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "patchId", "scenarioId", "verifiedAt", "status", "files", "blocked"],
  "properties": {
    "schemaVersion": {"type": "string", "minLength": 1},
    "patchId": {"type": "string", "minLength": 1},
    "scenarioId": {"type": "string", "minLength": 1},
    "verifiedAt": {"type": "string", "minLength": 1},
    "status": {"enum": ["accepted", "blocked"]},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "baseSha256", "currentSha256", "changed"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "baseSha256": {"type": "string", "minLength": 1},
          "currentSha256": {"type": "string", "minLength": 1},
          "changed": {"type": "boolean"}
        }
      }
    },
    "blocked": {"type": "array", "items": {"type": "string"}}
  }
}
