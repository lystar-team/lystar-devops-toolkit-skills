{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lystar-ui-design-eval-result.schema.json",
  "title": "UI Design Eval Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioId",
    "variant",
    "guidanceVersion",
    "render",
    "artifacts",
    "review"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "pattern": "^ui-[a-z0-9-]+$"
    },
    "variant": {
      "type": "string",
      "enum": ["baseline", "guided"]
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "guidanceVersion": {
      "type": "string",
      "minLength": 1
    },
    "inputFingerprint": {
      "type": "string"
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports"],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "themes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "states": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenshots"],
      "properties": {
        "screenshots": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "a11y": { "type": "string" },
        "console": { "type": "string" },
        "pageErrors": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "findings"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["keep", "revise", "revert", "no-rule"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["category", "severity", "message"],
            "properties": {
              "category": { "type": "string", "minLength": 1 },
              "severity": { "type": "string", "enum": ["blocking", "major", "minor", "note"] },
              "message": { "type": "string", "minLength": 1 },
              "ruleId": { "type": "string" }
            }
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": true
        },
        "reviewer": { "type": "string" }
      }
    }
  }
}
