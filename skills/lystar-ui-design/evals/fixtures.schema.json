{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lystar-ui-design-eval-fixture.schema.json",
  "title": "UI Design Eval Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "prompt", "render"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ui-[a-z0-9-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "artifact": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "input": {},
    "generation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "agent": { "type": "string" },
        "model": { "type": "string" },
        "settings": { "type": "object", "additionalProperties": true }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["viewports"],
      "properties": {
        "viewports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "width", "height"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knownFailures": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "holdout": {
      "type": "boolean",
      "default": false
    }
  }
}
